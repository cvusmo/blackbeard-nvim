# ~/.local/share/nvim/lazy/blackbeard-nvim/blackbeard-dark/gtk-2.0/gtkrc

# Color Definitions
# bg            #1C1B1A
# fg            #F4E3C1
# cursor        #F27835
# selection_bg  #F4A259
# selection_fg  #1C1B1A
# black         #454240
# red           #D13438
# green         #73A857
# yellow        #F1C232
# blue          #5A8CA5
# magenta       #A066C9
# cyan          #46B9A0
# white         #AA9E87
# brblack       #363533
# brred         #FF5F56
# brgreen       #88C070
# bryellow      #FADF60
# brblue        #73B3D8
# brmagenta     #B794F4
# brcyan        #6FE2CA
# brwhite       #F6E8CD

# Global Style
style "default"
{
  bg[NORMAL]      = "#1C1B1A"
  bg[PRELIGHT]    = "#AA9E87"  # white hover lift
  bg[ACTIVE]      = "#F1C232"  # yellow active
  bg[SELECTED]    = "#F4A259"
  bg[INSENSITIVE] = "#AA9E87"  # white disabled

  fg[NORMAL]      = "#F4E3C1"
  fg[PRELIGHT]    = "#F4E3C1"
  fg[ACTIVE]      = "#F4E3C1"
  fg[SELECTED]    = "#1C1B1A"
  fg[INSENSITIVE] = "#AA9E87"

  base[NORMAL]    = "#1C1B1A"
  base[PRELIGHT]  = "#AA9E87"
  base[ACTIVE]    = "#F4A259"
  base[SELECTED]  = "#F4A259"
  base[INSENSITIVE] = "#454240"

  text[NORMAL]    = "#F4E3C1"
  text[PRELIGHT]  = "#F4E3C1"
  text[ACTIVE]    = "#1C1B1A"
  text[SELECTED]  = "#1C1B1A"
  text[INSENSITIVE] = "#AA9E87"

  engine "murrine" {
    textstyle = 0
    roundness = 4
  }
}

class "*" style "default"

# Window Background
style "window"
{
  bg[NORMAL] = "#1C1B1A"
}
class "GtkWindow" style "window"

# Buttons
style "button"
{
  bg[NORMAL]   = "#454240"  # black softer
  bg[PRELIGHT] = "#AA9E87"  # white hover
  bg[ACTIVE]   = "#F1C232"  # yellow active
  fg[NORMAL]   = "#F4E3C1"
  fg[PRELIGHT] = "#F4E3C1"
  fg[ACTIVE]   = "#F4E3C1"

  engine "murrine" {
    border_radius = 6
    reliefstyle = 1
  }
}
class "GtkButton" style "button"

# Thunar buttons
style "thunar-button" = "button"
{
  bg[NORMAL]   = "#454240"
  bg[PRELIGHT] = "#AA9E87"
}
widget_class "*Thunar*GtkButton" style "thunar-button"

# Entries
style "entry"
{
  bg[NORMAL]   = "#1C1B1A"
  fg[NORMAL]   = "#F4E3C1"
  base[NORMAL] = "#1C1B1A"
  text[NORMAL] = "#F4E3C1"

  engine "murrine" {
    border_radius = 4
  }
}
class "GtkEntry" style "entry"

# Menu
style "menu"
{
  bg[NORMAL] = "#454240"  # black
  fg[NORMAL] = "#F4E3C1"
}
class "GtkMenu" style "menu"

style "menuitem"
{
  bg[PRELIGHT] = "#F4A259"  # selection hover
  fg[PRELIGHT] = "#1C1B1A"
  bg[SELECTED] = "#F4A259"
  fg[SELECTED] = "#1C1B1A"
}
class "GtkMenuItem" style "menuitem"

# Scrollbars
style "scrollbar"
{
  bg[NORMAL]   = "#1C1B1A"
  bg[PRELIGHT] = "#F6E8CD"  # brwhite hover
  bg[ACTIVE]   = "#F1C232"  # yellow active
  fg[NORMAL]   = "#F4E3C1"
  slider_width = 6

  engine "murrine" {
    border_radius = 6
  }
}
class "GtkScrollbar" style "scrollbar"

# Tooltips
style "tooltip"
{
  bg[NORMAL] = "#454240"
  fg[NORMAL] = "#F4E3C1"
}
class "GtkTooltip" style "tooltip"

# Progress Bar
style "progressbar"
{
  bg[NORMAL]   = "#1C1B1A"
  fg[NORMAL]   = "#73A857"  # green
}
class "GtkProgressBar" style "progressbar"

# Notebook (Tabs)
style "notebook"
{
  bg[NORMAL]   = "#1C1B1A"
  bg[ACTIVE]   = "#FADF60"  # bryellow active
  fg[NORMAL]   = "#F4E3C1"

  engine "murrine" {
    border_radius = 4
    tab_curvature = 4
  }
}
class "GtkNotebook" style "notebook"

# Treeview
style "treeview"
{
  bg[NORMAL]   = "#1C1B1A"
  base[NORMAL] = "#1C1B1A"
  text[NORMAL] = "#F4E3C1"
  base[PRELIGHT] = "#AA9E87"  # white hover
  text[PRELIGHT] = "#F4E3C1"
  base[SELECTED] = "#F4A259"
  text[SELECTED] = "#1C1B1A"
}
class "GtkTreeView" style "treeview"

# Thunar treeview
widget_class "*Thunar*GtkTreeView" style "treeview"
